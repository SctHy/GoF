# scripts/setup.sh generates apps/.env with independent random local credentials.
GCFEED_DB_ROOT_PASSWORD=generated-by-setup
GCFEED_DB_PASSWORD=generated-by-setup
GCFEED_MQ_PASSWORD=generated-by-setup
GCFEED_JWT_SECRET=generated-by-setup
GCFEED_INTERNAL_TOKEN=generated-by-setup
GCFEED_GRAFANA_PASSWORD=generated-by-setup

# Optional: comma-separated trusted reverse-proxy IPs/CIDRs. Empty ignores X-Forwarded-For.
GCFEED_TRUSTED_PROXIES=
